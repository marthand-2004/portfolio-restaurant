{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-restaurant",
  "compatibility_date": "2026-10-12",
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "portfolio-restaurant",
      "environment": "production"
    }
  ]
}
